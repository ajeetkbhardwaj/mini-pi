*.p12
*.pfx
*.crt
*.cer
.secrets
secrets/
credentials.json
token.json
*_secret*
*_credentials*

# -----------------------------------------------------------------------------
# Project-Specific: mini-pi
# -----------------------------------------------------------------------------

# Session store (local agent history)
.mini-pi/

# Session JSONL files
*.jsonl

# Agent scratch / working files
.scratch/
scratch/

# Compiled skills cache
.skills_cache/

# Extension build artifacts
extensions/__pycache__/

# Local model config overrides
local_config.yaml
local_config.json

# -----------------------------------------------------------------------------
